#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        combo_neovim {
            timeout-ms = <50>;
            key-positions = <15 16>;
            bindings = <&mo 2>;
            layers = <0>;
        };
    };

    macros {
        // "00"（KP_N0 を 2 回送る）numpad 用マクロ
        num_00: num_00 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp KP_N0 &kp KP_N0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&none      &kp B     &kp L     &kp D      &kp W      &kp Z                                    &kp COMMA  &kp F     &kp O      &kp U      &kp J     &none
&kp GRAVE  &kp N     &kp R     &kp T      &kp S      &kp G                                    &kp Y      &kp H     &kp A      &kp E      &kp I     &kp SQT
&kp LCTRL  &kp Q     &kp X     &kp P      &kp C      &kp V                                    &kp K      &kp M     &kp DOT    &kp MINUS  &kp FSLH  &kp RCTRL
&mo 3      &kp LALT  &kp LGUI  &kp TAB    &kp DEL    &mt LSHFT SPACE  &lt 1 RET  &lt 1 RET  &mt RSHFT SPACE  &kp BSPC  &kp ESC  &kp K_APP  &kp RALT  &mo 3
            >;
        };

        symbols_layer {
            display-name = "Symbols";
            bindings = <
&none      &kp LBRC  &kp RBRC  &kp LBKT   &kp RBKT   &kp CARET                                &kp PRCNT  &kp HASH  &kp LT     &kp GT     &kp DLLR  &none
&none      &kp SEMI  &kp PIPE  &kp AMPS   &kp N0     &kp COLON                                &kp AT     &kp N1    &kp LPAR   &kp RPAR   &kp EQUAL &none
&kp LCTRL  &kp N6    &kp N7    &kp N8     &kp N9     &kp PLUS                                 &kp ASTRK  &kp N2    &kp N3     &kp N4     &kp N5    &kp RCTRL
&none      &kp LALT  &kp LGUI  &kp TAB    &kp BSPC   &mt LSHFT SPACE  &kp RET    &kp RET    &mt RSHFT SPACE  &kp DEL   &kp ESC  &kp K_APP  &kp RALT  &none
            >;
        };

        neovim_layer {
            display-name = "Neovim";
            bindings = <
&none  &none  &none  &none  &none  &none                                                  &kp B   &none   &kp E   &kp W      &kp LS(H)  &none
&none  &none  &none  &none  &none  &none                                                  &kp H   &kp J   &kp K   &kp L      &kp LS(M)  &none
&none  &none  &none  &none  &none  &none                                                  &kp N0  &none   &none   &kp DLLR   &kp LS(L)  &none
&none  &none  &none  &none  &none  &none  &none                                    &none  &none   &none   &kp ESC &none      &none      &none
            >;
        };

        system_layer {
            display-name = "System";
            bindings = <
&none  &none  &none  &none  &none  &none                                                  &none        &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none                                                  &none        &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &bootloader                              &bootloader  &none        &none  &none  &none  &none
&none  &none  &none  &none  &none  &none        &none                       &none       &none        &none  &none  &none  &none  &none
            >;
        };
    };
};
