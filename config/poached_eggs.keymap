#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    macros {
        // "00"（KP_N0 を 2 回送る）numpad 用マクロ
        num_00: num_00 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp KP_N0 &kp KP_N0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp ESC  &kp B     &kp L     &kp D      &kp W      &kp Z                      &kp SQT   &kp F     &kp O     &kp U      &kp J    &none
&none    &kp N     &kp R     &kp T      &kp S      &kp G                      &kp Y     &kp H     &kp A     &kp E      &kp I    &none
&none    &kp Q     &kp X     &kp M      &kp C      &kp V                      &kp K     &kp P     &kp DOT   &kp MINUS  &kp FSLH &none
&mo 1    &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &kp SPACE  &none    &none  &kp BSPC  &kp RET   &kp DEL   &kp TAB    &none    &mo 1
            >;
        };

        lower_layer {
            display-name = "System";
            bindings = <
&none  &none  &none  &none  &none  &none                   &none        &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none                   &none        &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &bootloader             &bootloader  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none        &none &none &none       &none  &none  &none  &none  &none
            >;
        };

        raise_layer {
            display-name = "Raise";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6                   &kp F7    &kp F8     &kp F9     &kp F10   &kp F11    &kp F12
&none   &none   &none   &none   &none   &none                    &none     &kp LEFT   &kp DOWN   &kp UP    &kp RIGHT  &none
&none   &none   &none   &none   &none   &none                    &kp PLUS  &kp MINUS  &kp EQUAL  &kp LBKT  &kp RBKT   &kp BSLH
&none   &none   &none   &trans  &trans  &mo 3   &trans  &kp DEL  &trans    &trans     &trans     &none     &none      &none
            >;
        };

        bt_layer {
            display-name = "BT";
            bindings = <
&bt BT_CLR      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                &none  &none  &none  &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none                       &none  &none  &none  &none  &none  &none
&none           &none         &none         &none         &none         &none                       &none  &none  &none  &none  &none  &none
&kp O           &kp M         &kp U         &none         &none         &none         &none  &none  &none  &none  &none  &kp K  &kp E  &kp N
            >;
        };

        num_layer {
            display-name = "Num";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                       &kp KP_DIVIDE    &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_MINUS  &trans
&trans  &trans  &trans  &trans  &trans  &trans                       &kp KP_MULTIPLY  &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_PLUS   &trans
&trans  &trans  &trans  &trans  &trans  &trans                       &kp KP_EQUAL     &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_DOT    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp RET  &none  &kp BSPC  &kp KP_N0  &num_00  &kp COMMA  &trans
            >;
        };
    };
};
